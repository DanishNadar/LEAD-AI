# Keep this secret on the server. Never prefix it with NEXT_PUBLIC_.
CG_SCHOOL_CODE=your-campusgroups-school-code
CG_API_SECRET=replace-with-campusgroups-data-export-api-secret

# Required for a Vercel live sync: comma-separated CampusGroups group IDs that
# define the Leadership Academy cohort. This prevents school-wide metrics.
CG_REPORTING_GROUP_IDS=12345

# Optional: use only if CampusGroups gives your institution a nonstandard host.
# CG_API_BASE_URL=https://your-school.service.campusgroups.com/data/v1

# For the first live sync only, use the earliest approved historical date.
# Once a successful live pull exists, regular syncs use the selected lookback window.
# CG_INITIAL_SYNC_START=2024-08-01T00:00:00Z

# Required for live or scheduled syncs on Vercel. Create a Neon store through
# the Vercel Marketplace; it injects this connection string automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Survey free text is intentionally discarded by default. Set this to true only
# after your data-governance owner approves retaining de-identified response text.
# LEAD_RETAIN_SURVEY_TEXT=false

# Required before exposing POST /api/campusgroups/sync outside local development.
# INTERNAL_SYNC_TOKEN=replace-with-a-long-random-value

# Leave these unset in production. They only enable local demo controls if needed.
# LEAD_ALLOW_DEMO_SYNC=true
# LEAD_ALLOW_DEMO_RESET=true
# LEAD_ALLOW_DEMO_WRITES=true

# Admin access: comma-separated addresses that may receive a one-time code.
# ADMIN_EMAILS=admin@your-institution.edu
# Use a long random value; it signs OTP hashes and HttpOnly admin sessions.
# ADMIN_SESSION_SECRET=replace-with-a-long-random-value

# Gmail SMTP: use the mailbox address and a Gmail App Password, not the mailbox password.
# GMAIL_USER=lead-ai@your-institution.edu
# GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Vercel Cron automatically sends this as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=replace-with-a-long-random-value
